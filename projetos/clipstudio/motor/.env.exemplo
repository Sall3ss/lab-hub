# Copie para ".env" (que NAO vai para o Git) e preencha no SEU computador.
# Nunca cole a chave na conversa nem em arquivo versionado.

# Chave da Groq (https://console.groq.com/keys) - transcricao com Whisper.
GROQ_API_KEY=

# Endereco(s) da tela que podem chamar o motor, separados por virgula.
CLIPSTUDIO_ORIGENS=http://localhost:8788,https://lab-hub.pages.dev

# Pasta onde cada trabalho guarda video, audio e transcricao (uma subpasta por trabalho).
CLIPSTUDIO_DADOS=./dados

# Altura maxima do video baixado (720 = 720p). Maior = arquivo maior e mais lento.
CLIPSTUDIO_QUALIDADE=720

# Idioma falado na live (codigo ISO, ex.: pt, en, es). Vazio = a Groq detecta sozinha.
CLIPSTUDIO_IDIOMA=pt
